{
  "name": "teachmehipaa",
  "version": "1.0.0",
  "description": "Official Node.js and TypeScript library for the TeachMeHIPAA Developer API",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TeachMeHIPAA/teachmehipaa-node.git"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "check:dist": "node scripts/check-dist.mjs && TMH_README_TYPES=dist vitest run test/readme.test.ts test/code-samples.test.ts -t \"type-checks every sample\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.examples.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "generate": "tsx scripts/generate.ts",
    "test": "vitest run",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:sandbox": "vitest run --config vitest.sandbox.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@stoplight/prism-cli": "5.16.0",
    "@types/express": "5.0.3",
    "@types/node": "20.19.43",
    "ajv": "8.17.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "express": "5.2.1",
    "prettier": "3.10.1",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "3.2.7"
  },
  "scarfSettings": {
    "enabled": false
  }
}
