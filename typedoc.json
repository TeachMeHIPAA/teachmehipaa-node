{
  "$schema": "https://typedoc.org/schema.json",
  "name": "TeachMeHIPAA Node.js Library",
  "entryPoints": ["src/index.ts"],
  "out": "site",
  "readme": "README.md",
  "projectDocuments": [
    "docs/guides/client.md",
    "docs/guides/errors.md",
    "docs/guides/writes.md",
    "docs/guides/pagination.md",
    "docs/guides/operations.md",
    "docs/guides/webhooks.md",
    "docs/guides/testing.md",
    "docs/guides/compatibility.md",
    "docs/reference/resources.md",
    "examples/README.md"
  ],
  "plugin": [
    "typedoc-plugin-missing-exports",
    "./scripts/typedoc-document-titles.mjs"
  ],
  "placeInternalsInOwningModule": true,
  "excludeExternals": true,
  "treatWarningsAsErrors": true,
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "invalidPath": true,
    "rewrittenLink": true,
    "unusedMergeModuleWith": true
  }
}
